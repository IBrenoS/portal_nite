{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PORTAL_DEPLOYMENT_ENV",
        "VERCEL_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "NITE_NEWS_SOURCE",
        "CMS_PUBLIC_API_URL",
        "NITE_NEWS_MEDIA_URL",
        "CMS_PREVIEW_RESOLVE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
