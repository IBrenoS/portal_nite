{
  "name": "portal-nite",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@nite/web",
    "build": "turbo run build",
    "start": "npm run start --workspace=@nite/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "test:visual": "npm run test:visual --workspace=@nite/web --",
    "test:visual:update": "npm run test:visual:update --workspace=@nite/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deadcode": "knip",
    "check": "npm run format:check && npm run check:deadcode && turbo run lint typecheck && turbo run test && turbo run build"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "knip": "6.32.0",
    "prettier": "^3.8.3",
    "turbo": "2.10.9",
    "typescript": "^5"
  }
}
