{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-nite",
  "main": "worker/index.ts",
  "keep_vars": true,
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/preview",
      "/api/preview/exit",
      "/api/revalidate/news",
      "/projetos/software-aplicado",
      "/projetos/software-aplicado-demonstrativo",
      "/projetos/robotica-educacional",
      "/projetos/robotica-educacional-demonstrativo",
      "/projetos/dados-ia-demonstrativo",
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
