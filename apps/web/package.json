{
  "name": "@nite/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "playwright:install": "playwright install chromium",
    "cloudflare:build": "next build",
    "cloudflare:preview": "npm run cloudflare:build && wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:upload": "wrangler versions upload",
    "cloudflare:typegen": "node -e \"require('node:fs').mkdirSync('.wrangler',{recursive:true})\" && wrangler types --env-interface CloudflareEnv --include-runtime false .wrangler/cloudflare-env.d.ts",
    "cloudflare:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@gsap/react": "^2.1.2",
    "@nite/content": "0.1.0",
    "@nite/news": "0.1.0",
    "@nite/ui": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.9.0",
    "motion": "^12.38.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.5"
  }
}
