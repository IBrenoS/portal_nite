# Copie apenas como referência. `npm run env:setup` cria `.env.local` e gera
# automaticamente o secret interno compartilhado sem exibi-lo no terminal.

# Local; ajuste para a URL pública do Portal no ambiente implantado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NITE_NEWS_SOURCE=static

# Endpoints HTTPS e base pública provisionados externamente.
CMS_PUBLIC_API_URL=
NITE_NEWS_MEDIA_URL=
CMS_PREVIEW_RESOLVE_URL=

# Gerado pelo setup e igual ao valor do CMS Admin.
REVALIDATION_SECRET=
